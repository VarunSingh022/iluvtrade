# Copy to .env and fill in. Nothing here is read from a committed file.

# --- core ------------------------------------------------------------------
ILUVTRADE_ENVIRONMENT=development           # development | production
# Required in production. Derives the session-token HMAC and the key that
# encrypts broker credentials — changing it invalidates every session and every
# stored broker credential.
ILUVTRADE_SECRET_KEY=

# --- persistence -----------------------------------------------------------
# SQLite by default. Point at Postgres for anything beyond one machine.
# ILUVTRADE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/iluvtrade
# ILUVTRADE_STORAGE_ROOT=/var/lib/iluvtrade/storage

# --- sessions --------------------------------------------------------------
# ILUVTRADE_SESSION_TTL_SECONDS=43200

# --- data ingestion --------------------------------------------------------
# ILUVTRADE_MAX_UPLOAD_BYTES=268435456
# ILUVTRADE_MAX_FETCH_BYTES=67108864
# Comma-separated. EMPTY MEANS NO HOST MAY BE FETCHED — this is an allowlist,
# and "allow everything" is deliberately not a value it accepts.
# ILUVTRADE_FETCH_ALLOWED_HOSTS=data.example.com,files.example.org
# ILUVTRADE_FETCH_ALLOWED_PORTS=80,443

# --- jobs ------------------------------------------------------------------
# ILUVTRADE_BACKTEST_WORKER_COUNT=2
# ILUVTRADE_BACKTEST_TIMEOUT_SECONDS=300

# --- live trading ----------------------------------------------------------
# The deployment-level gate. A live session also needs the user's own setting
# and a per-session confirmation; all three must hold.
ILUVTRADE_LIVE_TRADING_ENABLED=false

# --- Zerodha (Kite Connect) ------------------------------------------------
# Requires a Kite Connect subscription and a registered app with a redirect URL.
# The key is public and appears in the login URL; the secret signs the session
# exchange and must never leave the server.
# ILUVTRADE_ZERODHA_API_KEY=
# ILUVTRADE_ZERODHA_API_SECRET=
